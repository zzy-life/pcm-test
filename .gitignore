# ====================
# 基础配置
# ====================

# 使用此规则忽略当前目录下的 .gitignore 文件本身（一般不需要，但防止误提交）
# .gitignore

# ====================
# Gradle / Build 文件
# ====================

# Gradle 文件
.gradle
/build/
gradle-app.setting

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# ====================
# IDE 相关配置
# ====================

# IntelliJ / Android Studio
*.iml
.idea/
# 注：如果您使用的是 Gradle，建议忽略 .idea 目录。
# 如果您不使用 Gradle 且不想分享 IDE 代码样式设置，可以取消下面这行的注释
# .idea/libraries/

# Keystore files
# 注意：不要把 .jks 或 .keystore 文件提交到代码库！
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json 通常建议不要提交，除非所有开发人员共用一个配置
# 如果您有团队共用的配置，请删除下面这行
# google-services.json

# ====================
# 操作系统生成的文件
# ====================

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ====================
# 旧的构建工具 (Eclipse/ADT 等)
# ====================

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle generated files
.gradle/
build/

# Signing files
.signing/

# Local configuration file (sdk path, etc)
local.properties

# 雾凇拼音原始词库缓存（构建脚本从 GitHub/CDN 拉取）
scripts/vendor/

# Proguard folder generated by Eclipse
proguard/

# ====================
# 敏感信息与临时文件
# ====================

# 如果您使用了 Sentry 等工具，可能会生成相关配置
sentry.properties

# ====================
# 可选：版本控制相关的忽略
# ====================

# .svn/
# .hg/
# .git/
/.claude
