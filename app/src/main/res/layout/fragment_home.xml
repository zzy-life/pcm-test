<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page">

    <com.hr.digitalhuman.view.AmbientFxView
        android:id="@+id/ambient_fx"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="34dp">

            <LinearLayout
                android:id="@+id/home_brand"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/home_title"
                    android:src="@drawable/ic_home_spark" />

                <TextView
                    android:id="@+id/tv_home_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/home_title"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_cover_ears"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="6dp"
                    android:contentDescription="@string/pause_listen"
                    android:src="@drawable/ic_cover_ears"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_home_slogan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxWidth="220dp"
                    android:maxLines="1"
                    android:text="@string/home_slogan"
                    android:textColor="@color/primary_bright"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_stop_speak"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dp"
                android:layout_toRightOf="@id/home_brand"
                android:background="@drawable/bg_home_chip"
                android:drawableLeft="@drawable/ic_home_stop"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingLeft="8dp"
                android:paddingRight="10dp"
                android:text="@string/stop_speak"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.hr.digitalhuman.view.AiPulseView
                    android:id="@+id/ai_pulse"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <TextView
                    android:id="@+id/tv_ai_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:ellipsize="end"
                    android:maxWidth="168dp"
                    android:maxLines="1"
                    android:text="就绪 · 请直接说话"
                    android:textColor="@color/primary_bright"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/listen_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp">

                    <View
                        android:id="@+id/listen_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_listen_dot" />

                    <TextView
                        android:id="@+id/tv_listen_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:drawableLeft="@drawable/ic_home_mic"
                        android:drawablePadding="3dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_listen_hint"
                        android:textColor="@color/primary_bright"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_history"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_home_chip"
                    android:drawableLeft="@drawable/ic_home_history"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="10dp"
                    android:text="历史"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_login_user"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_home_chip"
                    android:drawableLeft="@drawable/ic_home_user"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxWidth="120dp"
                    android:maxLines="1"
                    android:paddingLeft="8dp"
                    android:paddingRight="10dp"
                    android:text="@string/login"
                    android:textColor="@color/primary_bright"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_home_chip"
                    android:drawableLeft="@drawable/ic_home_logout"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingLeft="8dp"
                    android:paddingRight="10dp"
                    android:text="@string/logout"
                    android:textColor="@color/text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ai_dialog"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingTop="6dp"
                android:paddingRight="8dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/user_said_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/ic_home_chat"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="您说"
                        android:textColor="@color/primary_bright"
                        android:textSize="11sp" />

                    <ScrollView
                        android:id="@+id/scroll_user_said"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:overScrollMode="ifContentScrolls"
                        android:scrollbars="vertical">

                        <TextView
                            android:id="@+id/tv_user_latest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/text"
                            android:textSize="15sp" />
                    </ScrollView>
                </LinearLayout>

                <com.hr.digitalhuman.ui.display.CaptionBarView
                    android:id="@+id/caption_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <ScrollView
                    android:id="@+id/scroll_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.hr.digitalhuman.ui.display.DisplayCanvas
                        android:id="@+id/display_canvas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </ScrollView>
            </LinearLayout>

            <com.hr.digitalhuman.view.FlowBorderView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/quick_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/home_listen_hint"
                android:src="@drawable/ic_home_mic" />

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:hint="@string/input_hint"
                android:inputType="none"
                android:longClickable="false"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_btn_primary"
                android:drawableLeft="@drawable/ic_home_send"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/send"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
